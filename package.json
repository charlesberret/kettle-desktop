{
  "name": "setsweep-desktop",
  "version": "0.1.0",
  "description": "Electron shell for setsweep — wraps the local Python server in a native macOS window.",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "check": "node --check main.js && node --check preload.js && node --check scripts/smoke-sidecar.js",
    "smoke:sidecar": "node scripts/smoke-sidecar.js",
    "test": "npm run check && npm run smoke:sidecar",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "package:shell": "npm run smoke:sidecar && electron-forge package",
    "package": "npm run build:sidecar && npm run smoke:sidecar && electron-forge package",
    "install:app": "npm run package && bash scripts/install-app.sh",
    "reinstall": "npm run install:app",
    "reinstall:shell": "npm run package:shell && bash scripts/install-app.sh",
    "make": "npm run build:sidecar && npm run smoke:sidecar && electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "electron": "^42.5.1"
  },
  "config": {
    "forge": {
      "hooks": {
        "prePackage": "node scripts/patch-electron-extract.js"
      },
      "packagerConfig": {
        "name": "Setsweep",
        "executableName": "Setsweep",
        "appBundleId": "net.charlesberret.setsweep",
        "icon": "icon",
        "osxSign": false,
        "osxNotarize": false,
        "ignore": [
          "^/\\.build-venv($|/)",
          "^/build($|/)",
          "^/dist($|/)",
          "^/assets($|/)"
        ],
        "extraResource": [
          "resources/setsweep-sidecar",
          "resources/version.json"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        }
      ]
    }
  }
}
